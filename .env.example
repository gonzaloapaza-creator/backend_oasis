# Servidor
NODE_ENV=development
PORT=3001

# Frontend permitido para CORS
FRONTEND_URL=http://localhost:5173

# Base de datos - opción recomendada para producción
DATABASE_URL=postgresql://usuario:password@host:puerto/postgres

# Base de datos - opción alternativa local
DB_HOST=localhost
DB_PORT=5432
DB_NAME=hotel_oasis_resort
DB_USER=postgres
DB_PASSWORD=tu_password

# JWT
JWT_SECRET=coloca_una_clave_segura_de_minimo_32_caracteres
JWT_EXPIRES_IN=24h

# Rate limit
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX=100

# Datos del hotel
HOTEL_NAME=Hotel Oasis Resort
HOTEL_ADDRESS=Av. Mariscal Santa Cruz #1234, La Paz, Bolivia
HOTEL_PHONE=+591 2 2123456
HOTEL_EMAIL=info@hoteloasisresort.com

# Email opcional
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=tu_correo@gmail.com
EMAIL_PASS=tu_app_password
EMAIL_FROM=Hotel Oasis Resort <info@hoteloasisresort.com>

# Uploads
UPLOAD_PATH=uploads
MAX_FILE_SIZE=5242880
